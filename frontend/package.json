{
  "name": "receipt-manager-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../docs/openapi/openapi.yaml -o src/api/generated/schema.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/generated/schema.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "axios": "^1.20.0",
    "expo": "^58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "openapi-fetch": "^0.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  },
  "private": true
}
