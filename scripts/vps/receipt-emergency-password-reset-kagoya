#!/usr/bin/env bash
# Issue #132-4: KAGOYA専用、root限定の対話式緊急password再設定。
set -euo pipefail

die() { echo "[kagoya-emergency-password-reset] $1" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die 'must run as root'
[ "$#" -eq 0 ] || die 'this helper accepts no arguments'
[ -t 0 ] && [ -t 1 ] || die 'must run from an interactive terminal'

readonly backend_container='receipt-kagoya-validation-backend-1'
readonly backup_unit='receipt-backup-kagoya-validation.service'

[ "$(docker inspect --format '{{.State.Running}}' "${backend_container}" 2>/dev/null || true)" = true ] \
  || die 'backend container is not running'

read -r -p 'Target FamilyMember ID (local confirmation only): ' member_id
[[ "${member_id}" =~ ^[1-9][0-9]*$ ]] || die 'member ID is invalid'
read -r -p "Type reset-member-password-${member_id} to continue: " confirmation
[ "${confirmation}" = "reset-member-password-${member_id}" ] || die 'confirmation did not match'

systemctl start "${backup_unit}"
[ "$(systemctl show "${backup_unit}" -p Result --value)" = success ] \
  || die 'pre-reset backup did not succeed'

read -r -s -p 'New password: ' new_password
echo
read -r -s -p 'Repeat new password: ' new_password_confirmation
echo
[ "${new_password}" = "${new_password_confirmation}" ] || die 'password confirmation did not match'
[ "${#new_password}" -ge 15 ] && [ "${#new_password}" -le 128 ] \
  || die 'password must be 15-128 characters'
readonly reset_id="reset-$(date -u +%Y%m%d%H%M%S)-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"

# passwordはstdinだけでbackendへ渡す。argv、環境変数、journal、監査記録へ出さない。
if ! printf '%s' "${new_password}" | docker exec -i "${backend_container}" \
  npm exec tsx prisma/emergency-password-reset.ts "${member_id}" "${reset_id}"; then
  unset new_password new_password_confirmation
  die 'password reset did not complete'
fi
unset new_password new_password_confirmation
echo "[kagoya-emergency-password-reset] completed resetId=${reset_id} without exposing password values"
