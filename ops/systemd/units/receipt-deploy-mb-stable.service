[Unit]
Description=RecAIpt MacBook root-managed deployment
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-mb-stable
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredentialEncrypted=backend_database_url:/etc/receipt-ai-app/credentials/mb-stable/backend_database_url.cred
LoadCredentialEncrypted=backend_jwt_secret:/etc/receipt-ai-app/credentials/mb-stable/backend_jwt_secret.cred
LoadCredentialEncrypted=backend_totp_encryption_key:/etc/receipt-ai-app/credentials/mb-stable/backend_totp_encryption_key.cred
LoadCredentialEncrypted=backend_gemini_api_key:/etc/receipt-ai-app/credentials/mb-stable/backend_gemini_api_key.cred
LoadCredentialEncrypted=backend_ai_budget_discord_webhook:/etc/receipt-ai-app/credentials/mb-stable/backend_ai_budget_discord_webhook.cred
LoadCredentialEncrypted=backend_smtp_user:/etc/receipt-ai-app/credentials/mb-stable/backend_smtp_user.cred
LoadCredentialEncrypted=backend_smtp_password:/etc/receipt-ai-app/credentials/mb-stable/backend_smtp_password.cred
LoadCredentialEncrypted=backend_smtp_from:/etc/receipt-ai-app/credentials/mb-stable/backend_smtp_from.cred
LoadCredentialEncrypted=postgres_password:/etc/receipt-ai-app/credentials/mb-stable/postgres_password.cred
ExecStart=/usr/local/libexec/receipt-deploy mb-stable
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/receipt-ai-app/mb-stable /var/lib/receipt-ai-app/mb-stable /run/receipt-ai-app-mb-stable

[Install]
WantedBy=multi-user.target
