[Unit]
Description=RecAIpt MacBook root-managed backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-backup-mb-stable
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=db_password:/etc/receipt-ai-app/credentials/mb-stable/db_password.cred
LoadCredentialEncrypted=backup_discord_webhook_url:/etc/receipt-ai-app/credentials/mb-stable/backup_discord_webhook_url.cred
ExecStart=/usr/local/libexec/receipt-backup mb-stable
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/receipt-ai-app-backup-mb-stable /mnt/receipt-backups/receipt-app
