[Unit]
Description=RecAIpt stable Expo Go Metro (on demand)
After=network-online.target docker.service receipt-deploy-stable.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RemainAfterExit=yes
ExecStart=/usr/local/libexec/receipt-expo-go stable start
ExecStop=/usr/local/libexec/receipt-expo-go stable stop
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/receipt-ai-app-stable
