[Unit]
Description=Notify RecAIpt stable R2 offsite backup failure
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-offsite-backup-failure-stable
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=backup_discord_webhook_url:/etc/receipt-ai-app/credentials/stable/backup_discord_webhook_url.cred
ExecStart=/usr/local/libexec/receipt-offsite-backup-failure stable
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/receipt-ai-app-offsite-backup-failure-stable
