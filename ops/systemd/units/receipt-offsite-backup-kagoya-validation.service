[Unit]
Description=RecAIpt KAGOYA validation encrypted R2 offsite backup
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/receipt-ai-app/offsite-kagoya-validation.env
RuntimeDirectory=receipt-ai-app-offsite-backup-kagoya-validation
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=r2_access_key_id:/etc/receipt-ai-app/credentials/kagoya-validation/r2_access_key_id.cred
LoadCredentialEncrypted=r2_secret_access_key:/etc/receipt-ai-app/credentials/kagoya-validation/r2_secret_access_key.cred
LoadCredentialEncrypted=rclone_crypt_password:/etc/receipt-ai-app/credentials/kagoya-validation/rclone_crypt_password.cred
LoadCredentialEncrypted=rclone_crypt_salt:/etc/receipt-ai-app/credentials/kagoya-validation/rclone_crypt_salt.cred
ExecStart=/usr/local/libexec/receipt-offsite-backup kagoya-validation
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/receipt-ai-app-offsite-backup-kagoya-validation /var/backups/receipt-ai-app/kagoya-validation
