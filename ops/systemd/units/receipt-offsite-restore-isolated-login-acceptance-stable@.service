[Unit]
Description=RecAIpt stable isolated restore login and TOTP acceptance (%i)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-isolated-login-acceptance-stable
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=backend_jwt_secret:/etc/receipt-ai-app/credentials/stable/backend_jwt_secret.cred
LoadCredentialEncrypted=backend_totp_encryption_key:/etc/receipt-ai-app/credentials/stable/backend_totp_encryption_key.cred
ExecStart=/usr/local/libexec/receipt-offsite-restore-isolated-login-acceptance stable accept %i --confirm isolated-login-acceptance
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/receipt-ai-app-isolated-login-acceptance-stable /var/lib/receipt-ai-app-isolated-restore
