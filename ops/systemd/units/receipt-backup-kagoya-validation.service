[Unit]
Description=RecAIpt KAGOYA validation root backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-backup-kagoya-validation
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/receipt-backup-kagoya-validation
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/receipt-ai-app-backup-kagoya-validation /var/backups/receipt-ai-app/kagoya-validation
