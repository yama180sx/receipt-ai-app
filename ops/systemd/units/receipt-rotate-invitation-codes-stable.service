[Unit]
Description=RecAIpt stable invitation-code rotation
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-invitation-code-rotation-stable
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/receipt-rotate-invitation-codes stable
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/receipt-ai-app/stable /run/receipt-ai-app-invitation-code-rotation-stable
