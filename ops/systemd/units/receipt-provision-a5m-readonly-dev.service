[Unit]
Description=RecAIpt dev A5M2 read-only database role provision
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-a5m-readonly-dev
RuntimeDirectoryMode=0700
StateDirectory=receipt-ai-app/dev/a5m-credentials
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/receipt-provision-a5m-readonly dev
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/receipt-ai-app-a5m-readonly-dev
