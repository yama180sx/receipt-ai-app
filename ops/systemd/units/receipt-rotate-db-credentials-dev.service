[Unit]
Description=RecAIpt dev database credential rotation
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=receipt-ai-app-db-credential-rotation-dev
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/receipt-rotate-db-credentials dev
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/receipt-ai-app/credentials/dev /run/receipt-ai-app-db-credential-rotation-dev
