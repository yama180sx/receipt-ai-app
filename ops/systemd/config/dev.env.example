# root所有 /etc/receipt-ai-app/dev.env 用。Secretを書かない。
HOST_IP=192.0.2.10
WEB_PORT=8080
BACKEND_PORT=3000
DEV_PORT=8081
DB_PORT=5432
REDIS_PORT=6379
EXPO_PORT_1=19000
EXPO_PORT_2=19001
REDIS_PORT_INTERNAL=6379
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
GEMINI_RECEIPT_MODEL=gemini-3.5-flash-lite
GEMINI_PRODUCT_CLASSIFICATION_MODEL=gemini-3.5-flash-lite
