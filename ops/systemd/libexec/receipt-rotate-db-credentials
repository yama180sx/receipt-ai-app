#!/bin/bash
# Issue #132-1: アプリ用PostgreSQL credentialを値非表示で同期ローテーションする。
set -euo pipefail

readonly CONFIG_ROOT='/etc/receipt-ai-app'
readonly RUNTIME_PREFIX='/run/receipt-ai-app-db-credential-rotation'

die() { echo "[receipt-db-credential-rotation] $1" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die 'must run as root'
[ "$#" -eq 1 ] || die 'environment is fixed by the systemd unit'

case "$1" in
  dev|stable) readonly environment="$1" ;;
  *) die 'unknown fixed environment' ;;
esac

readonly credential_directory="${CONFIG_ROOT}/credentials/${environment}"
readonly database_container="receipt-${environment}-db"
readonly backend_container="receipt-${environment}-backend"
readonly backup_unit="receipt-backup-${environment}.service"
readonly deploy_unit="receipt-deploy-${environment}.service"
readonly runtime_directory="${RUNTIME_PREFIX}-${environment}"

install -d -o root -g root -m 0700 "${runtime_directory}"
readonly temporary_directory="$(mktemp -d -p "${runtime_directory}" rotation.XXXXXX)"
readonly original_directory="${temporary_directory}/original"
password_changed=false
credentials_installed=false
backup_credentials_reconciled=false
pre_rotation_backup_completed=false

cleanup() {
  local status="$?"
  trap - EXIT
  # DBだけを書き換えた直後にcredentialの設置が失敗した場合だけ、直前の
  # backend接続値とcredentialへ戻す。deploy開始後の失敗は新旧を混在させない
  # ため自動で戻さず、整合した新しいcredentialを保持して停止する。
  if [ "${status}" -ne 0 ] && [ "${password_changed}" = true ] && [ "${credentials_installed}" = false ]; then
    if [ -f "${current_password_file:-}" ]; then
      previous_password_hex="$(od -An -tx1 -v "${current_password_file}" | tr -d ' \\n')"
      printf "SELECT format('ALTER ROLE cntadm PASSWORD %%L', convert_from(decode('%s','hex'), 'UTF8')) \\gexec\\n" "${previous_password_hex}" |
        docker exec -i "${database_container}" psql -U cntadm -d receipt_db -v ON_ERROR_STOP=1 >/dev/null 2>&1 || true
    fi
    for name in backend_database_url postgres_password db_password; do
      [ -f "${original_directory}/${name}.cred" ] &&
        install -T -o root -g root -m 0600 "${original_directory}/${name}.cred" "${credential_directory}/${name}.cred" || true
    done
    echo '[receipt-db-credential-rotation] reverted the incomplete pre-deploy update without exposing credential values' >&2
  fi
  # 既存のbackup credentialが古い場合も、backendの実働値で認証できることを
  # 先に確認してから一時的に整合化する。最初のbackupが失敗した時だけ元へ戻す。
  if [ "${status}" -ne 0 ] && [ "${password_changed}" = false ] && \
     [ "${backup_credentials_reconciled}" = true ] && [ "${pre_rotation_backup_completed}" = false ]; then
    for name in postgres_password db_password; do
      install -T -o root -g root -m 0600 "${original_directory}/${name}.cred" "${credential_directory}/${name}.cred" || true
    done
    echo '[receipt-db-credential-rotation] reverted the unsuccessful backup-credential reconciliation without exposing credential values' >&2
  fi
  rm -rf -- "${temporary_directory}"
  exit "${status}"
}
trap cleanup EXIT

install -d -o root -g root -m 0700 "${original_directory}"
readonly docker_config_directory="${temporary_directory}/docker-config"
install -d -o root -g root -m 0700 "${docker_config_directory}"
export DOCKER_CONFIG="${docker_config_directory}"

for name in backend_database_url postgres_password db_password; do
  source="${credential_directory}/${name}.cred"
  [ -r "${source}" ] || die "required credential is unavailable: ${name}"
  install -T -o root -g root -m 0600 "${source}" "${original_directory}/${name}.cred"
done

[ "$(docker inspect --format '{{.State.Running}}' "${database_container}" 2>/dev/null || true)" = true ] \
  || die 'database container is not running'
[ "$(docker inspect --format '{{.State.Running}}' "${backend_container}" 2>/dev/null || true)" = true ] \
  || die 'backend container is not running'

# backendが実際に使っている接続URLから、値を表示せず現在のDB passwordをroot専用一時ファイルへ得る。
readonly current_password_file="${temporary_directory}/current-password"
docker exec "${backend_container}" node -e '
  const fs = require("node:fs");
  const source = process.env.DATABASE_URL_FILE;
  if (!source) process.exit(20);
  const value = fs.readFileSync(source, "utf8").trim();
  const url = new URL(value);
  if (url.username !== "cntadm" || url.hostname !== "db" || url.pathname !== "/receipt_db") process.exit(21);
  process.stdout.write(decodeURIComponent(url.password));
' > "${current_password_file}" || die 'backend database URL is unavailable or invalid'
chmod 0600 "${current_password_file}"

# appが使う現在値でTCP認証できなければ、部分更新を行わない。
docker exec -i "${database_container}" sh -ceu '
  IFS= read -r PGPASSWORD
  export PGPASSWORD
  psql -h 127.0.0.1 -U cntadm -d receipt_db -Atqc "SELECT 1" >/dev/null
' < "${current_password_file}" || die 'current application database credential does not authenticate'

write_credential() {
  local name="$1"
  local value="$2"
  printf '%s' "${value}" | systemd-creds encrypt --name="${name}" - "${temporary_directory}/${name}.cred"
  systemd-creds decrypt --name="${name}" "${temporary_directory}/${name}.cred" /dev/null >/dev/null
}

# backup helperはdb_passwordを読むため、backendの実働値で確認済みのcredentialへ
# 同期してから事前backupを取る。DB passwordとbackend URLはこの段階で変更しない。
write_credential postgres_password "$(< "${current_password_file}")"
write_credential db_password "$(< "${current_password_file}")"
for name in postgres_password db_password; do
  install -T -o root -g root -m 0600 \
    "${temporary_directory}/${name}.cred" "${credential_directory}/${name}.cred"
done
backup_credentials_reconciled=true

systemctl start "${backup_unit}"
[ "$(systemctl show "${backup_unit}" -p Result --value)" = success ] \
  || die 'pre-rotation backup did not succeed'
pre_rotation_backup_completed=true

readonly new_password="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
readonly new_url="postgresql://cntadm:${new_password}@db:5432/receipt_db?schema=public"
write_credential postgres_password "${new_password}"
write_credential db_password "${new_password}"
write_credential backend_database_url "${new_url}"

# 新しいpasswordはargv、環境変数、journalへ渡さず、stdinだけでDBへ渡す。
alter_role_password_from_hex() {
  local password_hex="$1"
  printf "SELECT format('ALTER ROLE cntadm PASSWORD %%L', convert_from(decode('%s','hex'), 'UTF8')) \\gexec\\n" "${password_hex}" |
    docker exec -i "${database_container}" psql -U cntadm -d receipt_db -v ON_ERROR_STOP=1 >/dev/null
}

alter_role_password_from_hex "$(printf '%s' "${new_password}" | od -An -tx1 -v | tr -d ' \\n')" \
  || die 'database password update failed'
password_changed=true

for name in backend_database_url postgres_password db_password; do
  install -T -o root -g root -m 0600 \
    "${temporary_directory}/${name}.cred" "${credential_directory}/${name}.cred"
done
credentials_installed=true

systemctl start "${deploy_unit}"
[ "$(systemctl show "${deploy_unit}" -p Result --value)" = success ] \
  || die 'post-rotation deployment did not succeed'

systemctl start "${backup_unit}"
[ "$(systemctl show "${backup_unit}" -p Result --value)" = success ] \
  || die 'post-rotation backup did not succeed'

echo "[receipt-db-credential-rotation] ${environment} completed without exposing credential values"
