#!/usr/bin/env bash
# Cloudflare R2の環境別credentialを、値を表示せずroot管理encrypted credentialへ登録する。
set -euo pipefail

die() { echo "[receipt-register-offsite-credentials] $1" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die 'must run as root'
[ "$#" -eq 1 ] || die 'usage: receipt-register-offsite-credentials {dev|stable}'

case "$1" in
  dev|stable) readonly environment="$1" ;;
  *) die 'unknown fixed environment' ;;
esac

readonly credential_directory="/etc/receipt-ai-app/credentials/${environment}"
command -v systemd-creds >/dev/null 2>&1 || die 'systemd-creds is unavailable'
command -v rclone >/dev/null 2>&1 || die 'rclone is unavailable'

prompt_secret() {
  local label="$1"
  local value
  printf '%s: ' "${label}" >&2
  IFS= read -r -s value
  printf '\n' >&2
  [ -n "${value}" ] || die "${label} must not be empty"
  printf '%s' "${value}"
}

write_credential() {
  local name="$1"
  local value="$2"
  local temporary

  [ -n "${value}" ] || die "credential input is empty: ${name}"
  [ ! -e "${credential_directory}/${name}.cred" ] \
    || die "credential already exists: ${name}; use the documented rotation procedure"
  temporary="$(mktemp "${credential_directory}/.${name}.XXXXXX")"
  if ! printf '%s' "${value}" | systemd-creds encrypt --name="${name}" - "${temporary}"; then
    rm -f -- "${temporary}"
    die "credential encryption failed: ${name}"
  fi
  if ! systemd-creds decrypt --name="${name}" "${temporary}" /dev/null >/dev/null; then
    rm -f -- "${temporary}"
    die "credential verification failed: ${name}"
  fi
  printf '%s\n' "${temporary}"
}

umask 077
install -d -o root -g root -m 0700 "${credential_directory}"

cat >&2 <<'NOTICE'
[receipt-register-offsite-credentials] Before continuing, store two different,
long random rclone crypt values in an encrypted password manager or equivalent
recovery kit. They are required to decrypt future R2 backups and are not shown
or retained by this helper in plaintext.
NOTICE
read -r -p 'Recovery kit is prepared (type yes): ' confirmation
[ "${confirmation}" = 'yes' ] || die 'recovery kit confirmation is required'

access_key_id="$(prompt_secret 'R2 access key ID')"
secret_access_key="$(prompt_secret 'R2 secret access key')"
crypt_password="$(prompt_secret 'rclone crypt password')"
crypt_salt="$(prompt_secret 'rclone crypt salt')"

# rclone obscureはstdinから受け取る。平文crypt値をprocess引数へ置かない。
obscured_crypt_password="$(printf '%s\n' "${crypt_password}" | rclone obscure -)"
obscured_crypt_salt="$(printf '%s\n' "${crypt_salt}" | rclone obscure -)"
[ -n "${obscured_crypt_password}" ] && [ -n "${obscured_crypt_salt}" ] \
  || die 'rclone crypt value obscuring failed'

temporary_access_key_id=''
temporary_secret_access_key=''
temporary_crypt_password=''
temporary_crypt_salt=''

cleanup() {
  rm -f -- "${temporary_access_key_id:-}" "${temporary_secret_access_key:-}" \
    "${temporary_crypt_password:-}" "${temporary_crypt_salt:-}"
  unset access_key_id secret_access_key crypt_password crypt_salt \
    obscured_crypt_password obscured_crypt_salt
}
trap cleanup EXIT

temporary_access_key_id="$(write_credential r2_access_key_id "${access_key_id}")"
temporary_secret_access_key="$(write_credential r2_secret_access_key "${secret_access_key}")"
temporary_crypt_password="$(write_credential rclone_crypt_password "${obscured_crypt_password}")"
temporary_crypt_salt="$(write_credential rclone_crypt_salt "${obscured_crypt_salt}")"

install -o root -g root -m 0600 "${temporary_access_key_id}" "${credential_directory}/r2_access_key_id.cred"
install -o root -g root -m 0600 "${temporary_secret_access_key}" "${credential_directory}/r2_secret_access_key.cred"
install -o root -g root -m 0600 "${temporary_crypt_password}" "${credential_directory}/rclone_crypt_password.cred"
install -o root -g root -m 0600 "${temporary_crypt_salt}" "${credential_directory}/rclone_crypt_salt.cred"

echo "[receipt-register-offsite-credentials] ${environment} encrypted R2 credentials installed and verified; no values were printed"
