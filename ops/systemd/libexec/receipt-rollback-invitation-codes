#!/bin/bash
# Issue #131-7: encrypted rollback artifactを使い、対象の再発行だけを値非表示で戻す。
set -euo pipefail

readonly DATA_ROOT="/var/lib/receipt-ai-app"

die() {
  echo "[receipt-invitation-code-rollback] $1" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "$#" -eq 2 ] || die "usage: receipt-rollback-invitation-codes {dev|stable|mb-stable} ROTATION_ID"

case "$1" in
  dev|stable|mb-stable) readonly ENVIRONMENT="$1" ;;
  *) die "unknown fixed environment" ;;
esac
readonly ROTATION_ID="$2"
[[ "${ROTATION_ID}" =~ ^rotation-[0-9]{14}-[0-9a-f]{8}$ ]] || die "rotation ID is invalid"

readonly CONTAINER_NAME="receipt-${ENVIRONMENT}-backend"
readonly DELIVERY_DIRECTORY="${DATA_ROOT}/${ENVIRONMENT}/invitation-code-rotations"
readonly ROLLBACK_CREDENTIAL="${DELIVERY_DIRECTORY}/${ROTATION_ID}.rollback.cred"
readonly RUNTIME_DIRECTORY="/run/receipt-ai-app-invitation-code-rollback-${ENVIRONMENT}"
install -d -o root -g root -m 0700 "${RUNTIME_DIRECTORY}"
readonly TEMPORARY_DIRECTORY="$(mktemp -d -p "${RUNTIME_DIRECTORY}" rollback.XXXXXX)"
readonly PLAINTEXT_MANIFEST="${TEMPORARY_DIRECTORY}/rollback.json"
readonly CONTAINER_MANIFEST="/tmp/${ROTATION_ID}-rollback.json"

cleanup() {
  docker exec "${CONTAINER_NAME}" rm -f "${CONTAINER_MANIFEST}" >/dev/null 2>&1 || true
  rm -rf -- "${TEMPORARY_DIRECTORY}"
}
trap cleanup EXIT

[ -f "${ROLLBACK_CREDENTIAL}" ] || die "rollback artifact is unavailable"
[ "$(stat -c '%u:%g:%a' "${ROLLBACK_CREDENTIAL}")" = "0:0:600" ] || die "rollback artifact ownership is invalid"
[ "$(docker inspect --format '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null || true)" = "true" ] || die "backend container is not running"

systemctl start "receipt-backup-${ENVIRONMENT}.service"
[ "$(systemctl show "receipt-backup-${ENVIRONMENT}.service" -p Result --value)" = "success" ] || die "pre-rollback backup did not succeed"

systemd-creds decrypt "${ROLLBACK_CREDENTIAL}" "${PLAINTEXT_MANIFEST}"
docker cp "${PLAINTEXT_MANIFEST}" "${CONTAINER_NAME}:${CONTAINER_MANIFEST}"
docker exec "${CONTAINER_NAME}" npm run invitation-codes:rollback -- \
  --rollback-input-file "${CONTAINER_MANIFEST}" \
  --confirm restore-invitation-codes

echo "[receipt-invitation-code-rollback] completed without exposing invitation-code values"
