#!/bin/bash
# Issue #131-7: 招待コードを値非表示で一括再発行し、配布用・rollback用の暗号化artifactだけを残す。
set -euo pipefail

readonly DATA_ROOT="/var/lib/receipt-ai-app"

die() {
  echo "[receipt-invitation-code-rotation] $1" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "$#" -eq 1 ] || die "environment is fixed by the systemd unit"

case "$1" in
  dev|stable) readonly ENVIRONMENT="$1" ;;
  *) die "unknown fixed environment" ;;
esac

readonly BACKUP_UNIT="receipt-backup-${ENVIRONMENT}.service"
readonly CONTAINER_NAME="receipt-${ENVIRONMENT}-backend"
readonly DATA_DIRECTORY="${DATA_ROOT}/${ENVIRONMENT}"
readonly DELIVERY_DIRECTORY="${DATA_DIRECTORY}/invitation-code-rotations"
readonly RUNTIME_DIRECTORY="/run/receipt-ai-app-invitation-code-rotation-${ENVIRONMENT}"

install -d -o root -g root -m 0700 "${DELIVERY_DIRECTORY}" "${RUNTIME_DIRECTORY}"

# 再発行前に、同一環境のroot管理backupが成功していなければ停止する。
systemctl start "${BACKUP_UNIT}"
[ "$(systemctl show "${BACKUP_UNIT}" -p Result --value)" = "success" ] || die "pre-rotation backup did not succeed"

[ "$(docker inspect --format '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null || true)" = "true" ] || die "backend container is not running"

readonly ROTATION_ID="rotation-$(date -u +%Y%m%d%H%M%S)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
readonly CONTAINER_DIRECTORY="/tmp/${ROTATION_ID}"
readonly CONTAINER_DELIVERY_FILE="${CONTAINER_DIRECTORY}/delivery.json"
readonly CONTAINER_ROLLBACK_FILE="${CONTAINER_DIRECTORY}/rollback.json"
readonly TEMPORARY_DIRECTORY="$(mktemp -d -p "${RUNTIME_DIRECTORY}" artifacts.XXXXXX)"
readonly DELIVERY_CREDENTIAL="${DELIVERY_DIRECTORY}/${ROTATION_ID}.delivery.cred"
readonly ROLLBACK_CREDENTIAL="${DELIVERY_DIRECTORY}/${ROTATION_ID}.rollback.cred"

cleanup() {
  docker exec "${CONTAINER_NAME}" rm -rf "${CONTAINER_DIRECTORY}" >/dev/null 2>&1 || true
  rm -rf -- "${TEMPORARY_DIRECTORY}"
}
trap cleanup EXIT

docker exec "${CONTAINER_NAME}" mkdir -p "${CONTAINER_DIRECTORY}"
docker exec "${CONTAINER_NAME}" npm run invitation-codes:rotate -- \
  --rotation-id "${ROTATION_ID}" \
  --delivery-output-file "${CONTAINER_DELIVERY_FILE}" \
  --rollback-output-file "${CONTAINER_ROLLBACK_FILE}" \
  --confirm rotate-all-invitation-codes

# docker cp と systemd-creds は値を標準出力に出さない。平文はroot専用runtimeに短時間だけ置く。
docker cp "${CONTAINER_NAME}:${CONTAINER_DELIVERY_FILE}" "${TEMPORARY_DIRECTORY}/delivery.json"
docker cp "${CONTAINER_NAME}:${CONTAINER_ROLLBACK_FILE}" "${TEMPORARY_DIRECTORY}/rollback.json"
systemd-creds encrypt --name="$(basename "${DELIVERY_CREDENTIAL}")" \
  "${TEMPORARY_DIRECTORY}/delivery.json" "${DELIVERY_CREDENTIAL}"
systemd-creds encrypt --name="$(basename "${ROLLBACK_CREDENTIAL}")" \
  "${TEMPORARY_DIRECTORY}/rollback.json" "${ROLLBACK_CREDENTIAL}"
chown root:root "${DELIVERY_CREDENTIAL}" "${ROLLBACK_CREDENTIAL}"
chmod 0600 "${DELIVERY_CREDENTIAL}" "${ROLLBACK_CREDENTIAL}"

echo "[receipt-invitation-code-rotation] completed without exposing invitation-code values"
