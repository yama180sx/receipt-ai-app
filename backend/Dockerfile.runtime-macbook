FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# MacBookの旧CPUではSharp native binaryが実行できない。WebAssembly fallbackだけを導入する。
RUN npm run install:sharp-wasm \
    && npx prisma generate \
    && mkdir -p /app/uploads \
    && chown -R node:node /app

USER node

EXPOSE 3000
CMD ["npm", "run", "start"]
