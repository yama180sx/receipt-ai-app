# 以下の直接値はローカル開発用。root管理unitでは *_FILE を使用する。
DATABASE_URL=
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-3.5-flash-lite
GEMINI_PRODUCT_CLASSIFICATION_MODEL=gemini-3.5-flash-lite
AI_BUDGET_DISCORD_WEBHOOK_URL=
BACKUP_DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# root管理unit用の例（ローカル開発時はコメントアウトのままにする）
# DATABASE_URL_FILE=/run/secrets/backend_database_url
# JWT_SECRET_FILE=/run/secrets/backend_jwt_secret
# TOTP_ENCRYPTION_KEY_FILE=/run/secrets/backend_totp_encryption_key
# GEMINI_API_KEY_FILE=/run/secrets/backend_gemini_api_key
# AI_BUDGET_DISCORD_WEBHOOK_URL_FILE=/run/secrets/backend_ai_budget_discord_webhook
# SMTP_USER_FILE=/run/secrets/backend_smtp_user
# SMTP_PASSWORD_FILE=/run/secrets/backend_smtp_password
# SMTP_FROM_FILE=/run/secrets/backend_smtp_from
CORS_ORIGIN=http://${T320_IP}:${WEB_PORT},http://${T320_IP}:${DEV_PORT}
RECEIPT_MANUAL_RETRY_LIMIT=1
RECEIPT_MANUAL_RETRY_FAILURE_CODES=gemini_daily_quota
RECEIPT_ANALYSIS_MAINTENANCE_MODE=false
