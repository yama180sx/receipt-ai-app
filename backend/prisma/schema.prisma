generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// [Issue #73] ユーザーの権限レベルを定義
enum Role {
  ADMIN // 管理者 (プロンプト編集・コスト統計の閲覧が可能)
  USER // 一般ユーザー (レシートの登録・閲覧のみ)
}

enum ReceiptAnalysisJobStatus {
  QUEUED
  PROCESSING
  AWAITING_CONFIRMATION
  FAILED
}

enum ProductTypeStatus {
  CLASSIFIED            @map("classified")
  NEEDS_REVIEW          @map("needs_review")
  UNCLASSIFIED          @map("unclassified")
  OUTSIDE_INITIAL_SCOPE @map("outside_initial_scope")
  NOT_APPLICABLE        @map("not_applicable")
}

enum ClassificationSource {
  HISTORY              @map("history")
  HOUSEHOLD_DICTIONARY @map("household_dictionary")
  STANDARD_DICTIONARY  @map("standard_dictionary")
  SIMILARITY           @map("similarity")
  AI                   @map("ai")
  MANUAL               @map("manual")
}

enum ClassificationConfidence {
  HIGH   @map("high")
  MEDIUM @map("medium")
  LOW    @map("low")
}

enum ProductClassificationAiRunStatus {
  SUCCEEDED         @map("succeeded")
  INVALID_RESPONSE  @map("invalid_response")
  PROVIDER_ERROR    @map("provider_error")
  PERSISTENCE_ERROR @map("persistence_error")
}

// [Issue #126] 外部AIの用途別単価を区別する。単価改定履歴と利用ログの共通キー。
enum AiUsagePurpose {
  OCR                    @map("ocr")
  PRODUCT_CLASSIFICATION @map("product_classification")
}

enum AiBudgetReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  EXPIRED
}

enum AiBudgetNotificationChannel {
  DISCORD
  EMAIL
}

enum AiBudgetNotificationKind {
  THRESHOLD
  TEST
}

enum AiBudgetNotificationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ClassificationCorrectionScope {
  ITEM_ONLY     @map("item_only")
  SAME_OCR_NAME @map("same_ocr_name")
}

enum ProductClassificationCandidateSource {
  HISTORY              @map("history")
  HOUSEHOLD_DICTIONARY @map("household_dictionary")
  STANDARD_DICTIONARY  @map("standard_dictionary")
}

enum ProductClassificationLearningDataType {
  HOUSEHOLD_DICTIONARY @map("household_dictionary")
}

enum ProductClassificationReclassificationRunStatus {
  COMPLETED       @map("completed")
  PARTIAL_FAILURE @map("partial_failure")
}

enum ProductClassificationReclassificationItemOutcome {
  UPDATED   @map("updated")
  UNCHANGED @map("unchanged")
  FAILED    @map("failed")
}

enum StandardProductClassificationRuleAuditAction {
  CREATED     @map("created")
  UPDATED     @map("updated")
  DEACTIVATED @map("deactivated")
}

// [Issue #45] 世帯（テナント）最上位テーブル
model FamilyGroup {
  id                                        Int                                        @id @default(autoincrement())
  name                                      String // 世帯名 (例: 山本家)
  inviteCode                                String                                     @unique @default(cuid()) // 家族招待用のコード
  members                                   FamilyMember[]
  receipts                                  Receipt[]
  receiptAnalysisJobs                       ReceiptAnalysisJob[]
  categories                                Category[]
  stores                                    Store[]
  promptTemplates                           PromptTemplate[]
  settlementTransfers                       SettlementTransfer[]
  productDictionaries                       HouseholdProductDictionary[]
  productHistories                          ProductClassificationHistory[]
  classificationCorrections                 ClassificationCorrection[]
  productClassificationLearningDataAudits   ProductClassificationLearningDataAudit[]
  productClassificationAiRuns               ProductClassificationAiRun[]
  productClassificationReclassificationRuns ProductClassificationReclassificationRun[]
  createdAt                                 DateTime                                   @default(now()) @db.Timestamptz(3)
}

// 家族構成
model FamilyMember {
  id                                        Int                                        @id @default(autoincrement())
  name                                      String
  password_hash                             String?
  familyGroupId                             Int // ★ 所属世帯
  role                                      Role                                       @default(USER) // [Issue #73] デフォルトは一般ユーザー
  totpSecret                                String? // [Issue #93-5] TOTP シークレット（暗号化保存）
  totpEnabled                               Boolean                                    @default(false)
  totpVerifiedAt                            DateTime?                                  @db.Timestamptz(3)
  familyGroup                               FamilyGroup                                @relation(fields: [familyGroupId], references: [id])
  receipts                                  Receipt[]
  receiptAnalysisJobs                       ReceiptAnalysisJob[]
  apiUsageLogs                              ApiUsageLog[] // [Issue #59] トークンログとのリレーション
  itemSplits                                ItemSplit[] // [Issue #78] 負担明細へのリレーション
  classificationCorrections                 ClassificationCorrection[]
  productClassificationLearningDataAudits   ProductClassificationLearningDataAudit[]
  productClassificationReclassificationRuns ProductClassificationReclassificationRun[]
  standardRulesCreated                      StandardProductClassificationRule[]        @relation("StandardRuleCreatedBy")
  standardRulesUpdated                      StandardProductClassificationRule[]        @relation("StandardRuleUpdatedBy")
  standardRuleAudits                        StandardProductClassificationRuleAudit[]   @relation("StandardRuleAuditActor")
  globalAiBudgetManager                     GlobalAiBudgetManager?
  globalAiBudgetAudits                      GlobalAiBudgetAudit[]

  // ★ [Issue #81] 送金履歴リレーション
  sentTransfers     SettlementTransfer[] @relation("TransferSender")
  receivedTransfers SettlementTransfer[] @relation("TransferReceiver")

  @@unique([name, familyGroupId]) // 同一世帯内での名前重複を禁止
}

// [Issue #124] FamilyGroupとは独立した、全体AI予算操作を許可する利用者。
model GlobalAiBudgetManager {
  id        Int          @id @default(autoincrement())
  memberId  Int          @unique
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
}

// [Issue #124] アプリケーション全体で一意なAI予算設定。id=1だけを使用する。
model GlobalAiBudgetSetting {
  id                Int      @id @default(1)
  isEnabled         Boolean  @default(false)
  monthlyBudgetJpy  Decimal? @db.Decimal(18, 6)
  warningPercent    Int      @default(50)
  criticalPercent   Int      @default(80)
  stopPercent       Int      @default(100)
  isStopped         Boolean  @default(false)
  stoppedReason     String?  @db.VarChar(64)
  stoppedAt         DateTime? @db.Timestamptz(3)
  notifyDiscord     Boolean   @default(true)
  notificationEmails String[] @default([])
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}

// 設定変更・停止・再開を追記で保持する。秘密値は保存しない。
model GlobalAiBudgetAudit {
  id            Int           @id @default(autoincrement())
  actorMemberId Int?
  actorMember   FamilyMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  action        String        @db.VarChar(64)
  reason        String?       @db.Text
  beforeValue   Json?
  afterValue    Json?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

// AI予算通知の配送台帳。DBを正本として、BullMQ障害後も未完了通知を回復する。
model AiBudgetNotificationDelivery {
  id               Int                            @id @default(autoincrement())
  dedupeKey        String                         @unique @db.VarChar(512)
  kind             AiBudgetNotificationKind
  month            String                         @db.VarChar(7)
  thresholdPercent Int
  channel          AiBudgetNotificationChannel
  recipient        String                         @db.VarChar(320)
  status           AiBudgetNotificationStatus     @default(PENDING)
  attempts         Int                            @default(0)
  nextAttemptAt    DateTime?                      @db.Timestamptz(3)
  sentAt           DateTime?                      @db.Timestamptz(3)
  lastError        String?                        @db.Text
  createdAt        DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                       @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([month, thresholdPercent])
}

// Gemini呼出し前に確保する全体予算の予約。ジョブ単位で、期限切れは後続Workerが解放する。
model AiBudgetReservation {
  id                Int                       @id @default(autoincrement())
  purpose           AiUsagePurpose
  pricingRevisionId Int
  pricingRevision   AiPricingRevision         @relation(fields: [pricingRevisionId], references: [id], onDelete: Restrict)
  jobKey            String                    @unique
  reservedCostJpy   Decimal                   @db.Decimal(18, 6)
  actualCostJpy     Decimal?                  @db.Decimal(18, 6)
  status            AiBudgetReservationStatus @default(RESERVED)
  expiresAt         DateTime                  @db.Timestamptz(3)
  settledAt         DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)

  @@index([status, expiresAt])
}

/// キューストア喪失時に未確定レシート解析を再投入するための永続台帳。
model ReceiptAnalysisJob {
  id               String                   @id @default(cuid())
  familyGroupId    Int
  familyGroup      FamilyGroup              @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  memberId         Int
  member           FamilyMember             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  imagePath        String
  status           ReceiptAnalysisJobStatus @default(QUEUED)
  failureCode      String?
  failureReason    String?
  manualRetryCount Int                      @default(0)
  lastEnqueuedAt   DateTime?                @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([familyGroupId, memberId, createdAt])
  @@index([status, updatedAt])
}

// 費目カテゴリー (世帯別マスタ — Issue #93-4)
model Category {
  id            Int         @id @default(autoincrement())
  name          String
  familyGroupId Int
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id])
  color         String?
  keywords      Json        @default("[]")
  // 値引き・アプリ適用など、統計時にレシート内の通常Categoryへ配賦する調整明細用。
  isAdjustment  Boolean     @default(false)
  items         Item[]

  @@unique([name, familyGroupId])
  @@index([familyGroupId])
  @@index([familyGroupId, isAdjustment])
}

// 店舗正規化マスタ (世帯別マスタ — Issue #93-4)
model Store {
  id            Int         @id @default(autoincrement())
  officialName  String
  familyGroupId Int
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id])
  aliases       Json        @default("[]")

  @@unique([officialName, familyGroupId])
  @@index([familyGroupId])
}

model Receipt {
  id                          Int                          @id @default(autoincrement())
  familyGroupId               Int // ★ 世帯ID (論理分離の主軸)
  familyGroup                 FamilyGroup                  @relation(fields: [familyGroupId], references: [id])
  memberId                    Int
  member                      FamilyMember                 @relation(fields: [memberId], references: [id])
  storeName                   String
  normalizedStoreName         String                       @default("")
  date                        DateTime                     @db.Timestamptz(3)
  totalAmount                 Int // 支払合計（税込）
  // [Issue #71] 外税額を保持するフィールド
  taxAmount                   Float                        @default(0.0)
  rawText                     Json?
  imagePath                   String?
  items                       Item[]
  apiUsageLogs                ApiUsageLog[] // [Issue #59] トークンログとのリレーション
  productClassificationAiRuns ProductClassificationAiRun[]
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)

  @@index([familyGroupId, date]) // 検索効率化
}

model Item {
  id                       Int                       @id @default(autoincrement())
  receiptId                Int
  receipt                  Receipt                   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  categoryId               Int?
  category                 Category?                 @relation(fields: [categoryId], references: [id])
  standardCategoryId       Int?
  standardCategory         StandardCategory?         @relation(fields: [standardCategoryId], references: [id])
  productTypeId            Int?
  productType              ProductType?              @relation(fields: [productTypeId], references: [id])
  productTypeStatus        ProductTypeStatus         @default(UNCLASSIFIED)
  classificationSource     ClassificationSource?
  classificationConfidence ClassificationConfidence?
  name                     String
  normalizedName           String                    @default("")
  price                    Float
  quantity                 Float                     @default(1.0)

  // [Issue #78] 負担割合の内訳（1対多）
  splits                                      ItemSplit[]
  classificationCorrections                   ClassificationCorrection[]
  productClassificationCandidates             ProductClassificationCandidate[]
  productClassificationReclassificationAudits ProductClassificationReclassificationItemAudit[]

  @@index([standardCategoryId])
  @@index([productTypeId])
  @@index([productTypeStatus])
}

// 共通の固定家計簿カテゴリ。世帯ごとのCategoryから段階的に移行する。
model StandardCategory {
  id           Int                @id @default(autoincrement())
  code         String             @unique
  name         String
  parentId     Int?
  parent       StandardCategory?  @relation("StandardCategoryHierarchy", fields: [parentId], references: [id])
  children     StandardCategory[] @relation("StandardCategoryHierarchy")
  displayOrder Int
  isActive     Boolean            @default(true)
  color        String?

  productTypes        ProductType[]
  classificationRules StandardProductClassificationRule[]
  items               Item[]

  @@unique([parentId, name])
  @@index([parentId, displayOrder])
}

// 共通の商品種別。必ず標準カテゴリに属する。
model ProductType {
  id                 Int              @id @default(autoincrement())
  code               String           @unique
  name               String
  standardCategoryId Int
  standardCategory   StandardCategory @relation(fields: [standardCategoryId], references: [id])
  displayOrder       Int
  isActive           Boolean          @default(true)

  items                           Item[]
  standardClassificationRules     StandardProductClassificationRule[]
  householdDictionaries           HouseholdProductDictionary[]
  classificationHistories         ProductClassificationHistory[]
  previousCorrections             ClassificationCorrection[]          @relation("PreviousProductType")
  nextCorrections                 ClassificationCorrection[]          @relation("NextProductType")
  productClassificationCandidates ProductClassificationCandidate[]

  @@unique([standardCategoryId, name])
  @@index([standardCategoryId, displayOrder])
}

// 全世帯共通の、正規化済み商品名に対する包含分類ルール。
model StandardProductClassificationRule {
  id                 Int                                      @id @default(autoincrement())
  normalizedKeyword  String
  standardCategoryId Int
  standardCategory   StandardCategory                         @relation(fields: [standardCategoryId], references: [id])
  productTypeId      Int
  productType        ProductType                              @relation(fields: [productTypeId], references: [id])
  priority           Int
  isActive           Boolean                                  @default(true)
  createdByMemberId  Int?
  createdByMember    FamilyMember?                            @relation("StandardRuleCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  updatedByMemberId  Int?
  updatedByMember    FamilyMember?                            @relation("StandardRuleUpdatedBy", fields: [updatedByMemberId], references: [id], onDelete: SetNull)
  lastChangeReason   String
  createdAt          DateTime                                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                                 @updatedAt @db.Timestamptz(3)
  audits             StandardProductClassificationRuleAudit[]

  @@unique([normalizedKeyword, productTypeId])
  @@index([isActive, priority])
  @@index([productTypeId])
}

model StandardProductClassificationRuleAudit {
  id                Int                                          @id @default(autoincrement())
  ruleId            Int
  rule              StandardProductClassificationRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  action            StandardProductClassificationRuleAuditAction
  actorMemberId     Int?
  actorMember       FamilyMember?                                @relation("StandardRuleAuditActor", fields: [actorMemberId], references: [id], onDelete: SetNull)
  normalizedKeyword String
  productTypeId     Int
  productTypeName   String
  priority          Int
  isActive          Boolean
  reason            String
  createdAt         DateTime                                     @default(now()) @db.Timestamptz(3)

  @@index([ruleId, createdAt])
  @@index([actorMemberId])
}

// 以下は世帯固有の学習データ。すべてfamilyGroupIdで分離する。
model HouseholdProductDictionary {
  id             Int         @id @default(autoincrement())
  familyGroupId  Int
  familyGroup    FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  normalizedName String
  productTypeId  Int
  productType    ProductType @relation(fields: [productTypeId], references: [id])
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([familyGroupId, normalizedName])
  @@index([productTypeId])
}

model ProductClassificationHistory {
  id             Int         @id @default(autoincrement())
  familyGroupId  Int
  familyGroup    FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  normalizedName String
  productTypeId  Int
  productType    ProductType @relation(fields: [productTypeId], references: [id])
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([familyGroupId, normalizedName])
  @@index([productTypeId])
}

model ClassificationCorrection {
  id                    Int                           @id @default(autoincrement())
  familyGroupId         Int
  familyGroup           FamilyGroup                   @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  itemId                Int
  item                  Item                          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actorMemberId         Int?
  actorMember           FamilyMember?                 @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  previousProductTypeId Int?
  previousProductType   ProductType?                  @relation("PreviousProductType", fields: [previousProductTypeId], references: [id])
  nextProductTypeId     Int?
  nextProductType       ProductType?                  @relation("NextProductType", fields: [nextProductTypeId], references: [id])
  scope                 ClassificationCorrectionScope
  createdAt             DateTime                      @default(now()) @db.Timestamptz(3)

  @@index([familyGroupId, createdAt])
  @@index([itemId])
  @@index([actorMemberId])
}

// 世帯固有の辞書の無効化を、理由と対象世帯を含めて追跡する監査ログ。
// ポリモーフィックな対象IDはスナップショットとして保持し、学習データ側を変更しても監査証跡を残す。
model ProductClassificationLearningDataAudit {
  id               Int                                   @id @default(autoincrement())
  familyGroupId    Int
  familyGroup      FamilyGroup                           @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  actorMemberId    Int?
  actorMember      FamilyMember?                         @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  learningDataType ProductClassificationLearningDataType
  learningDataId   Int
  normalizedName   String
  productTypeId    Int
  productTypeName  String
  reason           String
  createdAt        DateTime                              @default(now()) @db.Timestamptz(3)

  @@index([familyGroupId, createdAt])
  @@index([learningDataType, learningDataId])
}

// 既存明細の再分類実行と変更内容を世帯単位で追跡する監査ログ。
model ProductClassificationReclassificationRun {
  id             Int                                              @id @default(autoincrement())
  familyGroupId  Int
  familyGroup    FamilyGroup                                      @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  actorMemberId  Int
  actorMember    FamilyMember                                     @relation(fields: [actorMemberId], references: [id], onDelete: Restrict)
  targetStatuses ProductTypeStatus[]
  startDate      DateTime?                                        @db.Timestamptz(3)
  endDate        DateTime?                                        @db.Timestamptz(3)
  limit          Int
  selectedCount  Int                                              @default(0)
  updatedCount   Int                                              @default(0)
  unchangedCount Int                                              @default(0)
  failedCount    Int                                              @default(0)
  status         ProductClassificationReclassificationRunStatus
  createdAt      DateTime                                         @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?                                        @db.Timestamptz(3)
  itemAudits     ProductClassificationReclassificationItemAudit[]

  @@index([familyGroupId, createdAt])
  @@index([actorMemberId])
}

model ProductClassificationReclassificationItemAudit {
  id                           Int                                              @id @default(autoincrement())
  runId                        Int
  run                          ProductClassificationReclassificationRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId                       Int
  item                         Item                                             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  outcome                      ProductClassificationReclassificationItemOutcome
  previousCategoryId           Int?
  nextCategoryId               Int?
  previousStandardCategoryId   Int?
  nextStandardCategoryId       Int?
  previousProductTypeId        Int?
  nextProductTypeId            Int?
  previousProductTypeStatus    ProductTypeStatus
  nextProductTypeStatus        ProductTypeStatus
  previousClassificationSource ClassificationSource?
  nextClassificationSource     ClassificationSource?
  errorMessage                 String?
  createdAt                    DateTime                                         @default(now()) @db.Timestamptz(3)

  @@unique([runId, itemId])
  @@index([itemId])
  @@index([outcome])
}

// 類似検索で得た候補。候補自体は商品種別の確定を意味しない。
model ProductClassificationCandidate {
  id                    Int                                  @id @default(autoincrement())
  itemId                Int
  item                  Item                                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productTypeId         Int
  productType           ProductType                          @relation(fields: [productTypeId], references: [id])
  source                ProductClassificationCandidateSource
  matchedNormalizedName String
  similarity            Float
  rank                  Int
  createdAt             DateTime                             @default(now()) @db.Timestamptz(3)

  @@unique([itemId, productTypeId])
  @@unique([itemId, rank])
  @@index([productTypeId])
}

// [Issue #78] レシート明細ごとの負担内訳
// レコードが存在しない場合（0件）は「レシート登録者の全額負担」とみなす（暗黙的デフォルト）
model ItemSplit {
  id             Int      @id @default(autoincrement())
  itemId         Int
  familyMemberId Int
  amount         Int // 精算用金額（端数を丸めた日本円のためInt）
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id])

  @@index([itemId])
  @@index([familyMemberId])
}

// ★ [Issue #81] 送金履歴（締め処理の実績管理）
model SettlementTransfer {
  id            Int         @id @default(autoincrement())
  familyGroupId Int
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id])
  month         String // 例: "2026-05" (精算対象月)
  fromMemberId  Int // 送金した人
  toMemberId    Int // 受け取った人
  amount        Int // 送金額
  settledAt     DateTime    @default(now()) @db.Timestamptz(3)

  sender   FamilyMember @relation("TransferSender", fields: [fromMemberId], references: [id])
  receiver FamilyMember @relation("TransferReceiver", fields: [toMemberId], references: [id])

  @@index([month])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([familyGroupId])
}

// [Issue #59] Gemini API トークン使用量トラッキング
model ApiUsageLog {
  id                   Int                @id @default(autoincrement())
  familyMemberId       Int? // 実行したユーザー
  familyMember         FamilyMember?      @relation(fields: [familyMemberId], references: [id])
  receiptId            Int? // 関連するレシート
  receipt              Receipt?           @relation(fields: [receiptId], references: [id])
  modelId              String // 例: "gemini-1.5-flash"
  promptTokens         Int // 入力トークン
  candidatesTokens     Int // 出力トークン
  totalTokens          Int // 合計トークン
  selfRepairRetryCount Int                @default(0) // 算術不整合の自己修復再解析回数
  durationMs           Int                @default(0) // Gemini API応答時間（自己修復分を累積）
  pricingRevisionId    Int?
  pricingRevision      AiPricingRevision? @relation("ApiUsageLogPricingRevision", fields: [pricingRevisionId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)

  @@index([familyMemberId])
  @@index([createdAt])
}

// 商品分類AIの評価・障害分析用の実行ログ。OCR用ApiUsageLogとは分離する。
model ProductClassificationAiRun {
  id                Int                              @id @default(autoincrement())
  familyGroupId     Int
  familyGroup       FamilyGroup                      @relation(fields: [familyGroupId], references: [id])
  receiptId         Int?
  receipt           Receipt?                         @relation(fields: [receiptId], references: [id])
  modelId           String
  promptTokens      Int                              @default(0)
  candidatesTokens  Int                              @default(0)
  totalTokens       Int                              @default(0)
  targetItemCount   Int
  classifiedCount   Int                              @default(0)
  needsReviewCount  Int                              @default(0)
  unreturnedCount   Int                              @default(0)
  status            ProductClassificationAiRunStatus
  failureCode       String?                          @db.VarChar(64)
  durationMs        Int
  pricingRevisionId Int?
  pricingRevision   AiPricingRevision?               @relation("ProductClassificationAiRunPricingRevision", fields: [pricingRevisionId], references: [id], onDelete: Restrict)
  createdAt         DateTime                         @default(now()) @db.Timestamptz(3)

  @@index([familyGroupId, createdAt])
  @@index([receiptId])
}

// [Issue #126] Geminiのモデル・用途ごとの単価改定履歴。更新・削除は行わず追記する。
model AiPricingRevision {
  id                       Int            @id @default(autoincrement())
  purpose                  AiUsagePurpose
  modelId                  String
  inputPriceJpyPerMillion  Decimal        @db.Decimal(18, 6)
  outputPriceJpyPerMillion Decimal        @db.Decimal(18, 6)
  maxInputTokens           Int
  maxOutputTokens          Int
  effectiveFrom            DateTime       @db.Timestamptz(3)
  sourceUrl                String         @db.Text
  verifiedAt               DateTime       @db.Timestamptz(3)
  verifiedBy               String
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)

  apiUsageLogs              ApiUsageLog[]                @relation("ApiUsageLogPricingRevision")
  productClassificationRuns ProductClassificationAiRun[] @relation("ProductClassificationAiRunPricingRevision")
  budgetReservations        AiBudgetReservation[]

  @@unique([purpose, modelId, effectiveFrom])
  @@index([purpose, modelId, effectiveFrom])
}

// [Issue #72/76] AIプロンプト管理マスタ (世帯別 — Issue #93-4)
model PromptTemplate {
  id            Int         @id @default(autoincrement())
  familyGroupId Int
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id])
  key           String // 例: "RECEIPT_ANALYSIS"
  name          String      @default("デフォルトプロンプト")
  description   String?
  systemPrompt  String      @db.Text
  domainHints   Json?
  isActive      Boolean     @default(false)
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  @@index([familyGroupId, key, isActive])
}
